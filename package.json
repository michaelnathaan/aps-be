{
  "name": "aps-backend",
  "version": "1.0.0",
  "description": "Apartment Booking System - REST vs GraphQL Backend",
  "main": "index.js",
  "scripts": {
    "dev:rest": "ts-node-dev --respawn --transpile-only src/rest/app.ts",
    "dev:graphql": "ts-node-dev --respawn --transpile-only src/graphql/server.ts",
    "build": "tsc",
    "start:rest": "node dist/rest/app.js",
    "start:graphql": "node dist/graphql/server.js",
    "test": "jest",
    "test:parity": "jest tests/parity",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": ["graphql", "rest", "performance", "research"],
  "author": "Michael Laswardi",
  "license": "MIT",
  "dependencies": {
    "@apollo/server": "^4.10.0",
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "dotenv": "^16.4.1",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "pino": "^8.17.2",
    "pino-http": "^9.0.0",
    "graphql": "^16.8.1",
    "dataloader": "^2.2.2",
    "graphql-depth-limit": "^1.1.0",
    "date-fns": "^3.3.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/jest": "^29.5.11",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4"
  }
}